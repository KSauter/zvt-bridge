# systemd unit for zvt-bridge (Linux, e.g. Raspberry Pi)
# Install:
#   sudo install -m 755 zvt-bridge /usr/local/bin/
#   sudo install -m 644 zvt-bridge.service /etc/systemd/system/
#   sudo install -d /etc/zvt-bridge && sudo install -m 644 zvt-bridge.conf /etc/zvt-bridge/
#   edit /etc/zvt-bridge/zvt-bridge.conf (serial port, terminal address), then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now zvt-bridge
[Unit]
Description=ZVT Bridge (serial ECR <-> TCP payment terminal)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/zvt-bridge run -config /etc/zvt-bridge/zvt-bridge.conf
Restart=always
RestartSec=5
DynamicUser=yes
SupplementaryGroups=dialout
LogsDirectory=zvt-bridge
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
