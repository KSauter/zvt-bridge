# systemd unit for zvt-bridge (Linux, e.g. Raspberry Pi)
# Install:
#   sudo install -m 755 zvt-bridge /usr/local/bin/
#   sudo install -m 644 zvt-bridge.service /etc/systemd/system/
#   adjust ExecStart (serial port, terminal address), then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now zvt-bridge
[Unit]
Description=ZVT Bridge (serial ECR <-> TCP payment terminal)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/zvt-bridge run -serial /dev/ttyUSB0 -terminal 192.168.1.50 -log /var/log/zvt-bridge/zvt-bridge.log
Restart=always
RestartSec=5
DynamicUser=yes
SupplementaryGroups=dialout
LogsDirectory=zvt-bridge
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
